using System;

namespace домашка
{
    internal class Program
    {
        static void Main(string[] args)
        {
            Arena arena = new Arena();

            arena.Play();
        }
    }

    public class Arena
    {
        Worior[] woriors =
        {
           new Paladin("Паладин", 45, 6, 3),
           new Rogue("Плут", 35, 8, 2),
           new Barbarian("Варвар", 60, 4, 1),
           new Mage("Волшебник", 30, 3, 1),
           new Monck("Монах", 35, 7, 2)
        };

        public void Play()
        {
            int number = 1;
            foreach (var worior in woriors)
            {
                Console.Write(number + ") ");
                worior.ShowStats();
                number++;
            }

            ShowFight();
        }

        public void ShowFight()
        {
            Console.WriteLine(new string('-', 60));
            int firstFighterNumber = UserUtils.ReadChoice(woriors.Length);
            Worior firstWorior = woriors[firstFighterNumber].Clone();

            int secondFighterNumber = UserUtils.ReadChoice(woriors.Length);
            Worior secondWorior = woriors[secondFighterNumber].Clone();
            Console.WriteLine(new string('-', 60) + "\n\n");

            StartRound(secondWorior, firstWorior);

            StartRound(firstWorior, secondWorior);

            while (firstWorior.Health > 0 && secondWorior.Health > 0)
            {
                PerformTurn(secondWorior, firstWorior);

                PerformTurn(firstWorior, secondWorior);
            }

                Console.WriteLine(new string('-', 60));
                if (firstWorior.Health <= 0 && secondWorior.Health <= 0)
                    Console.WriteLine("Ничья! Оба бойца пали.");
                else if (firstWorior.Health <= 0)
                    Console.WriteLine($"{secondWorior.Name} побеждает!");
                else if(secondWorior.Health <= 0)
                    Console.WriteLine($"{firstWorior.Name} побеждает!");
        }

        private void StartRound(Worior attacker, Worior defender)
        {
            if (attacker.Name == "Волшебник")
            {
                int damage = attacker.Atack();
                UserUtils.TimeToTurn();
                defender.GetHit(damage);
                defender.ShowCurrentHealth();
            }
            else
            {
                attacker.FirstMoove(attacker.Name);
            }
        }

        private bool PerformTurn(Worior attacker, Worior defender)
        {
            Console.Write(attacker.Name);
            int damage = attacker.Atack();
            UserUtils.TimeToTurn();

            defender.GetHit(damage);
            defender.ShowCurrentHealth();
            Console.ReadKey();

            return defender.Health > 0;
        }
    }

    abstract class Worior
    {
        protected Worior(string name, int health, int damage, int armor)
        {
            Name = name;
            Health = health;
            Damage = damage;
            Armor = armor;
        }

        public abstract Worior Clone();

        public void ShowStats()
        {
            Console.WriteLine($"Боец - {Name}, Здоровье: {Health}, Защита: {Armor}, Урон: {Damage}");
        }

        public void GetHit(int damage)
        {
            Health = TakeDamage(damage, Health);
        }

        public virtual int TakeDamage(int damage, int currentHealth)
        {
            int netDamage = Math.Max(0, damage - Armor);
            return currentHealth - netDamage;
        }

        public virtual int Atack()
        {
            Console.Write($" Атакует ({Damage}) урона. ");
            return Damage;
        }

        public void ShowCurrentHealth()
        {
            Console.WriteLine($"У бойца {Name} - {Health} здоровья.");
        }

        public virtual void FirstMoove(string name)
        {
            Console.WriteLine($"{name} Бежит к противнику.");
        }

        public string Name { get; private set; }
        public int Health { get; private set; }
        public int Damage { get; private set; }
        public int Armor { get; private set; }
    }

    class Paladin : Worior
    {
        int creetChance = 7;
        int minChance = 1;
        int maxChance = 10;

        public Paladin(string name, int health, int damage, int armor) : base(name, health, damage, armor) { }

        public override Worior Clone() => new Paladin(Name, Health, Damage, Armor);

        public override int Atack()
        {
            int powerOfAtack;

            if (UserUtils.GenerateRandomNumber(minChance, maxChance + 1) <= creetChance)
            {
                powerOfAtack = Damage * 3;
                Console.Write($" Атакует -- Критческий удар ({powerOfAtack}) урона. ");

                return powerOfAtack;
            }
            else
            {
                powerOfAtack = Damage;
                Console.Write($" Атакует ({powerOfAtack}) урона. ");
                return powerOfAtack;
            }
        }
    }

    class Rogue : Worior
    {
        public Rogue(string name, int health, int damage, int armor) : base(name, health, damage, armor) { }

        private int atackCount = 0;
        private int powerOfAtack;

        public override Worior Clone() => new Rogue(Name, Health, Damage, Armor);

        public override int Atack()
        {
            atackCount++;

            if (atackCount >= 3)
            {
                powerOfAtack = Damage * 2;
                Console.Write($" Атакует -- Двойная атака ({powerOfAtack}) урона. ");
                atackCount = 0;
            }
            else
            {
                powerOfAtack = Damage;
                Console.Write($" Атакует ({powerOfAtack}) урона. ");
            }
            return powerOfAtack;
        }
    }

    class Barbarian : Worior
    {
        public Barbarian(string name, int health, int damage, int armor) : base(name, health, damage, armor) { }

        private int _rageBar = 0;
        private int _rage = 25;
        private int _rageHeal = 20;

        public override Worior Clone() => new Barbarian(Name, Health, Damage, Armor);

        public override int TakeDamage(int damage, int health)
        {
            int currentHealth = health;
            int netDamage = Math.Max(0, damage - Armor);
            currentHealth -= netDamage;
            _rageBar += _rage;

            if (_rageBar >= 100)
            {
                Console.Write(" !!!Варвар впадает в ярость (+ 20 здоровья)!!! ");
                currentHealth += _rageHeal;
                _rageBar = 0;
            }
            return currentHealth;
        }
    }

    class Mage : Worior
    {
        public Mage(string name, int health, int damage, int armor) : base(name, health, damage, armor) { }

        private int powerOfAtack;
        private int manaPool = 100;
        private int firstSpellManaCost = 40;
        private int secondSpellManaCost = 10;
        private int firstSpellDamage = 15;
        private int secondSpellDamage = 4;

        public override Worior Clone() => new Mage(Name, Health, Damage, Armor);

        public override int Atack()
        {
            if (manaPool >= firstSpellManaCost)
            {
                powerOfAtack = firstSpellDamage;
                manaPool -= firstSpellManaCost;
                Console.Write($" Атакует -- FIREBOLL ({powerOfAtack}) урона. ");
            }
            else if (manaPool >= secondSpellManaCost)
            {
                powerOfAtack = secondSpellDamage;
                manaPool -= secondSpellManaCost;
                Console.Write($" Атакует -- Обжигающее касание ({powerOfAtack}) урона. ");
            }
            else
            {
                powerOfAtack = Damage;
                Console.Write($" Атакует -- Удар палкой ({powerOfAtack}) урона. ");
            }
            return powerOfAtack;
        }
    }

    class Monck : Worior
    {
        int minChance = 1;
        int maxChance = 11;
        int dodgeChance = 3;

        public Monck(string name, int health, int damage, int armor) : base(name, health, damage, armor) { }

        public override Worior Clone() => new Monck(Name, Health, Damage, Armor);

        public override int TakeDamage(int damage, int health)
        {
            int currentHealth = health;

            if (UserUtils.GenerateRandomNumber(minChance, maxChance) <= dodgeChance)
            {
                int netDamage = Math.Max(0, damage - Armor);
                currentHealth -= netDamage;
            }
            else
            {
                Console.Write(" Монах увернулся!!! ");
            }
            return currentHealth;
        }
    }

    static class UserUtils
    {
        private static Random _random = new Random();

        public static int GenerateRandomNumber(int minNumber, int maxNumber)
        {
            return _random.Next(minNumber, maxNumber);
        }

        public static void TimeToTurn()
        {
            System.Threading.Thread.Sleep(1000);
        }

        public static int ReadChoice(int max)
        {
            while (true)
            {
                string input = Console.ReadLine();
                if (int.TryParse(input, out int choice) && choice >= 1 && choice <= max)
                    return choice - 1;
                Console.Write($"Некорректный ввод. Введите число от 1 до {max}: ");
            }
        }
    }
}
