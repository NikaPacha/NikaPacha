    class Worior
    {
        protected string Name;
        protected int Health;
        protected int Damage;
        protected int Armor;

        protected Worior(string name, int health, int damage, int armor)
        {
            Name = name;
            Health = health;
            Damage = damage;
            Armor = armor;
        }

        protected void TakeDamage(int damage)
        {
            Health -= damage - Armor;
        }

        protected void ShowCurrentHealth(string name, int health)
        {
            Console.WriteLine(name + "осталось" + health + "здоровья");
        }
    }

    class Knight : Worior
    {
        public Knight(string name, int health, int damage, int armor) : base(name, health, damage, armor){}

        private void CritDamage(int damage)
        {
            Damage *= 2;
        }
    }

