using System;
using System.Collections.Generic;
using System.Linq;

namespace Homework
{
    class Program
    {
        static void Main(string[] args)
        {
            RailwayStation railway = new RailwayStation();

            railway.Run();
        }
    }

    class RailwayStation
    {
        public void Run()
        {
            const string CommandForm = "1";
            const string CommandExit = "2";

            TrainConfigurator trainConfigurator = new TrainConfigurator();
            bool isWork = true;

            while (isWork)
            {
                char spase = ' ';
                int specifiedCellLength = 20;
                string quantityOfWagons = "Кол-во вагонов";
                string cityOfDeparture = "Направление";
                string quantityOfTicketsOfTrain = "Кол-во билетов";

                Console.Clear();
                string wagons =
                    $"{quantityOfWagons}{Utils.СreateCell(Convert.ToString(quantityOfWagons), specifiedCellLength, spase)}";
                string direction = $"{cityOfDeparture}{Utils.СreateCell(cityOfDeparture, specifiedCellLength, spase)}";
                string quantityOfTickets =
                    $"{quantityOfTicketsOfTrain}{Utils.СreateCell(quantityOfTicketsOfTrain, specifiedCellLength, spase)}";

                Console.WriteLine($"||{wagons}|{direction}|{quantityOfTickets}||");
                trainConfigurator.ShowTrain();
                Console.WriteLine($"\nМеню: \n{CommandForm} - Сформировать поезд\n{CommandExit} - Выход");

                switch (Console.ReadLine())
                {
                    case CommandForm:
                        trainConfigurator.FormTrain();
                        break;

                    case CommandExit:
                        isWork = false;
                        break;

                    default:
                        Console.WriteLine("Введите пункт меню!");
                        Console.ReadKey();
                        break;
                }
            }
        }
    }
}

class Utils
{
    public static int RandomInteger(int quantityMin, int quantityMax)
    {
        Random random = new Random();
        int number = random.Next(quantityMin, quantityMax);
        return number;
    }

    public static string СreateCell(string line, int fullLengthOfLine, char separatorColumn)
    {
        return String.Concat(Enumerable.Repeat(separatorColumn, fullLengthOfLine - line.Length));
    }
}

class TrainConfigurator
{
    private List<Train> _trainСomposition = new List<Train>();

    public void FormTrain()
    {
        string direction = CreateDirection();
        int quantityOfTickets = IssueTickets();
        List<Wagon> wagons = CreateWagons(quantityOfTickets);
        Train train = new Train(wagons, direction, quantityOfTickets);
        _trainСomposition.Add(train);
    }

    public void ShowTrain()
    {
        char spase = ' ';
        int specifiedCellLength = 20;

        foreach (var train in _trainСomposition)
        {
            string wagons =
                $"{train.wagons.Count}{Utils.СreateCell(Convert.ToString(train.wagons.Count), specifiedCellLength, spase)}";
            string direction =
                $"{train.Direction}{Utils.СreateCell(Convert.ToString(train.Direction), specifiedCellLength, spase)}";
            string quantityOfTickets =
                $"{train.QuantityOfTickets}{Utils.СreateCell(Convert.ToString(train.QuantityOfTickets), specifiedCellLength, spase)}";
            Console.WriteLine($"||{wagons}|{direction}|{quantityOfTickets}||");
        }
    }

    private string CreateDirection()
    {

        bool isCorrect = false;

        while (!isCorrect)
        {
            string cityOfDeparture = ReadCity("Укажите город отправления: ");
            string cityOfArrival = ReadCity("Укажите город назначения: ");

            if (cityOfDeparture == cityOfArrival)
            {
                Console.WriteLine("Ошибка маршрута! \n");
                Console.ReadKey();
            }
            else
            {
                Direction direction = new Direction(cityOfDeparture, cityOfArrival);

                return direction.ToString();
            }
        }
        return string.Empty;
    }

    private string ReadCity(string message)
    {
        Console.Write(message);
        return Console.ReadLine();
    }

    private int IssueTickets()
    {
        int quantityTrainOfPassengersMin = 10;
        int quantityTrainOfPassengersMax = 3000;
        int quantityOfTickets = Utils.RandomInteger(quantityTrainOfPassengersMin, quantityTrainOfPassengersMax);
        return quantityOfTickets;
    }

    private List<Wagon> CreateWagons(int quantityOfTickets)
    {
        List<Wagon> wagons = new List<Wagon>();
        int quantitySeatsInOfWagon = 56;

        while (quantityOfTickets >= 0)
        {
            Wagon wagon = new Wagon(quantitySeatsInOfWagon);
            quantityOfTickets -= quantitySeatsInOfWagon;
            wagons.Add(wagon);
        }

        return wagons;
    }
}

class Wagon
{
    public int QuantitySeatsInOfWagon { get; private set; }

    public Wagon(int quantitySeatsInOfWagon)
    {
        QuantitySeatsInOfWagon = quantitySeatsInOfWagon;
    }
}

class Train
{
    public string Direction { get; private set; }
    public int QuantityOfTickets { get; private set; }

    private List<Wagon> _wagons;
    public IReadOnlyList<Wagon> wagons => _wagons;

    public Train(List<Wagon> wagons, string direction, int quantityOfTickets)
    {
        _wagons = wagons;
        Direction = direction;
        QuantityOfTickets = quantityOfTickets;
    }
}

class Direction
{
    public string DeparturePoint { get; private set; }
    public string ArrivalPoint { get; private set; }

    public Direction(string departurePoint, string arrivalPoint)
    {
        DeparturePoint = departurePoint;
        ArrivalPoint = arrivalPoint;
    }

    public override string ToString()
    {
        return DeparturePoint + "-" + ArrivalPoint;
    }
}
