using System;
using System.Collections.Generic;

namespace Homework
{
    class Program
    {
        static void Main(string[] args)
        {
            var station = new RailwayStation();

            station.Run();
        }
    }

    class RailwayStation
    {
        private readonly List<Train> _trains = new List<Train>();
        private readonly TrainConfigurator _trainConfigurator = new TrainConfigurator();

        public void Run()
        {
            const string CommandForm = "1";
            const string CommandExit = "2";

            bool isWork = true;

            while (isWork)
            {
                char spase = ' ';
                int specifiedCellLength = 20;

                string seatsCount = "Кол-во вагонов";
                string cityOfDeparture = "Направление";
                string ticketsCount = "Кол-во билетов";

                Console.Clear();

                string wagons =
                    $"{seatsCount}{Utils.CreateCell(Convert.ToString(seatsCount), specifiedCellLength, spase)}";
                string direction = $"{cityOfDeparture}{Utils.CreateCell(cityOfDeparture, specifiedCellLength, spase)}";
                string quantityOfTickets =
                    $"{ticketsCount}{Utils.CreateCell(ticketsCount, specifiedCellLength, spase)}";

                Console.WriteLine($"||{wagons}|{direction}|{quantityOfTickets}||");
                Console.WriteLine(new string('-', 70));

                ShowTrains(_trains, specifiedCellLength, spase);

                Console.WriteLine(new string('-', 70));
                Console.WriteLine($"\nМеню: \n{CommandForm} - Сформировать поезд\n{CommandExit} - Выход");

                switch (Console.ReadLine())
                {
                    case CommandForm:
                        var train = _trainConfigurator.FormTrain();
                        _trains.Add(train);
                        break;

                    case CommandExit:
                        isWork = false;
                        break;

                    default:
                        Console.WriteLine("Введите пункт меню!");
                        Console.ReadKey();
                        break;
                }
            }
        }

        public void ShowTrains(List<Train> trains, int cellLength, char spase)
        {
            if (trains.Count == 0)
            {
                Console.WriteLine("||Нет сформированных поездов.||");
                return;
            }

            foreach (var train in trains)
            {
                string wagons =
                    $"{train.Wagons.Count}{Utils.CreateCell(Convert.ToString(train.Wagons.Count), cellLength, spase)}";
                string direction =
                    $"{train.Direction}{Utils.CreateCell(Convert.ToString(train.Direction), cellLength, spase)}";
                string quantityOfTickets =
                    $"{train.QuantityOfTickets}{Utils.CreateCell(Convert.ToString(train.QuantityOfTickets), cellLength, spase)}";

                Console.WriteLine($"||{wagons}|{direction}|{quantityOfTickets}||");
            }
        }
    }

    class Utils
    {
        private static readonly Random _random = new Random();

        public static int RandomInteger(int quantityMin, int quantityMax)
        {

            return _random.Next(quantityMin, quantityMax);
        }

        public static string CreateCell(string line, int fullLengthOfLine, char separatorColumn)
        {
            if (line.Length >= fullLengthOfLine) return string.Empty;
            return new string(separatorColumn, fullLengthOfLine - line.Length);
        }
    }

    class TrainConfigurator
    {
        public Train FormTrain()
        {
            string direction = CreateDirection();
            int quantityOfTickets = IssueTickets();

            List<Wagon> wagons = CreateWagons(quantityOfTickets);

            return new Train(wagons, direction, quantityOfTickets);
        }

        private string CreateDirection()
        {
            bool isCorrect = false;

            while (!isCorrect)
            {
                string cityOfDeparture = ReadCity("Укажите город отправления: ");
                string cityOfArrival = ReadCity("Укажите город назначения: ");

                if (cityOfDeparture == cityOfArrival)
                {
                    Console.WriteLine("Ошибка маршрута! \n");
                    Console.ReadKey();
                }
                else
                {
                    Direction direction = new Direction(cityOfDeparture, cityOfArrival);

                    return direction.ToString();
                }
            }
            return string.Empty;
        }

        private string ReadCity(string message)
        {
            Console.Write(message);
            return Console.ReadLine();
        }

        private int IssueTickets()
        {
            int minPassengers = 10;
            int maxPassengers = 3000;
            return Utils.RandomInteger(minPassengers, maxPassengers);

        }

        private List<Wagon> CreateWagons(int quantityOfTickets)
        {
            List<Wagon> wagons = new List<Wagon>();
            int seatsPerWagon = 56;

            while (quantityOfTickets > 0)
            {
                Wagon wagon = new Wagon(seatsPerWagon);
                quantityOfTickets -= seatsPerWagon;
                wagons.Add(wagon);
            }

            return wagons;
        }
    }

    class Wagon
    {
        public int QuantitySeatsInOfWagon { get; private set; }

        public Wagon(int quantitySeatsInOfWagon)
        {
            QuantitySeatsInOfWagon = quantitySeatsInOfWagon;
        }
    }

    class Train
    {
        public string Direction { get; private set; }
        public int QuantityOfTickets { get; private set; }

        private List<Wagon> _wagons;
        public IReadOnlyList<Wagon> Wagons => _wagons;

        public Train(List<Wagon> wagons, string direction, int quantityOfTickets)
        {
            _wagons = wagons;
            Direction = direction;
            QuantityOfTickets = quantityOfTickets;
        }
    }

    class Direction
    {
        public string DeparturePoint { get; private set; }
        public string ArrivalPoint { get; private set; }

        public Direction(string departurePoint, string arrivalPoint)
        {
            DeparturePoint = departurePoint;
            ArrivalPoint = arrivalPoint;
        }

        public override string ToString()
        {
            return DeparturePoint + "-" + ArrivalPoint;
        }
    }
}
